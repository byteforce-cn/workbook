{
  "kind": "workbook",
  "schemaVersion": "4.1.1",
  "locale": "zh-CN",
  "i18n": {
    "zh-CN": {
      "workbook.form.submit": "提交表单",
      "workbook.form.reset": "重置表单",
      "workbook.steps.previous": "上一步",
      "workbook.steps.next": "下一步",
      "custom.greeting": "你好，世界"
    },
    "en": {
      "workbook.form.submit": "Submit",
      "workbook.form.reset": "Reset",
