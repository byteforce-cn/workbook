{
  "kind": "workbook",
  "schemaVersion": "4.1.1",
  "locale": "zh-CN",
  "data": {
    "customer": {
      "name": "Alice"
    }
  },
  "views": [
    {
      "type": "page",
      "id": "page-preview",
      "label": "页面 conformance",
      "pageSettings": {
        "width": 595,
        "height": 842,
        "marginTop": 72,
        "marginLeft": 72,
        "marginRight": 72,
        "marginBottom": 72
      },
      "content": [
        {
          "type": "paragraph",
          "runs": [
            { "type": "text", "text": "客户：" },
            {
              "type": "text",
              "bind": {
                "path": "customer.name",
                "mode": "oneWay"
              }
            }
          ]
        },
        {
          "type": "list",
          "listType": "bullet",
          "items": [
            [
              {
                "type": "paragraph",
                "runs": [{ "type": "text", "text": "条目一" }]
              }
            ]
          ]
        },
        {
          "type": "table",
          "columns": [200, 200],
          "rows": [
            {
              "cells": [
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "runs": [{ "type": "text", "text": "字段" }]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "runs": [{ "type": "text", "text": "值" }]
                    }
                  ]
                }
              ]
            },
            {
              "cells": [
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "runs": [{ "type": "text", "text": "客户姓名" }]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "runs": [{ "type": "text", "text": "Alice" }]
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "page-break" },
        {
          "type": "paragraph",
          "runs": [{ "type": "text", "text": "第二页" }]
        }
      ]
    }
  ]
}
